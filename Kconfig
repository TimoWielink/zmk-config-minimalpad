# Minimalpad firmware additions: the host module and the underglow's idle fade
# SPDX-License-Identifier: MIT

menuconfig MINIMALPAD_HOST
    bool "Minimalpad host module"
    depends on ZMK_BLE
    default y
    help
      The device channel Minimalpad Studio uses for what ZMK Studio RPC cannot
      do: switching the pad to a profile layer, setting the underglow colour,
      and the heartbeat that returns the pad to Default when Studio goes away.
      It runs over its own GATT service. The wire format is
      docs/protocol/host-protocol.md in minimalpad-studio-mac, and
      include/minimalpad/mp_host_protocol.h here is a verbatim copy of its
      C header.

if MINIMALPAD_HOST

config MINIMALPAD_HOST_HEARTBEAT_DEFAULT_TIMEOUT
    int "Fallback window, in seconds, before the host's first HEARTBEAT"
    range 1 255
    default 6
    help
      host-protocol.md has Studio send HEARTBEAT every 2 seconds with a 6
      second window, and each HEARTBEAT sets the window from then on. Until
      the first one arrives, SET_PROFILE and SET_LEDS arm the fallback with
      this window, so a host that stops between switching and its first
      heartbeat still cannot leave the pad on a profile (ADR 0005).

config MINIMALPAD_HOST_LEDS_FORCE_SOLID
    bool "Show a host colour with the solid effect"
    depends on ZMK_RGB_UNDERGLOW
    default y
    help
      The spectrum and swirl effects ignore the colour, so a profile colour
      would not show while one of them runs. The effect that was in use
      before the host set a colour comes back on fallback.

module = MINIMALPAD_HOST
module-str = Minimalpad host module
source "subsys/logging/Kconfig.template.log_config"

endif # MINIMALPAD_HOST

menuconfig MINIMALPAD_LEDS_IDLE_FADE
    bool "Fade the underglow out when the pad goes idle"
    depends on ZMK_RGB_UNDERGLOW && !ZMK_RGB_UNDERGLOW_AUTO_OFF_IDLE
    default y
    help
      Takes the place of ZMK_RGB_UNDERGLOW_AUTO_OFF_IDLE, which switches the
      underglow off the moment the pad goes idle. This dims it slowly first,
      then switches it off the same way, cutting the LEDs' power. A key or the
      dial brings it straight back. When the pad restarts while the underglow
      is off for idle, after deep sleep, a reset or a flat battery, the
      underglow comes back on, where ZMK's option leaves it off.

if MINIMALPAD_LEDS_IDLE_FADE

config MINIMALPAD_LEDS_IDLE_FADE_MS
    int "How long the fade takes, in milliseconds"
    range 0 30000
    default 8000
    help
      The fade starts when the pad goes idle, ZMK_IDLE_TIMEOUT after the last
      key press or dial turn. 0 switches the underglow off at once, as ZMK's
      own option does. The breathe effect sets its own brightness, so it does
      not dim and simply stops at the end.

module = MINIMALPAD_LEDS
module-str = Minimalpad LEDs
source "subsys/logging/Kconfig.template.log_config"

endif # MINIMALPAD_LEDS_IDLE_FADE
