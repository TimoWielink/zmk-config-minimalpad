#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT   0
#define SHORTCUTS 1

/ {
    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder0>;
        triggers-per-rotation = <10>;
    };

    keymap {
        compatible = "zmk,keymap";

        // ╔══════════╦══════════╦══════════╦══════════╗
        // ║  PREV    ║  PLAY/   ║  NEXT    ║  MUTE    ║  Media transport + mute
        // ║  TRACK   ║  PAUSE   ║  TRACK   ║          ║
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║ RGB TOG  ║ RGB NEXT ║ RGB BRI+ ║ RGB HUE+ ║  RGB underglow controls
        // ║          ║  EFFECT  ║          ║          ║
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║ BT PROF  ║ BT PROF  ║ BT PROF  ║ BT CLEAR ║  Bluetooth profiles
        // ║    1     ║    2     ║    3     ║ this dev ║
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║ BT PREV  ║ BT NEXT  ║ USB/BLE  ║ [HOLD]→  ║  BT nav + output + layer
        // ║ PROFILE  ║ PROFILE  ║  TOGGLE  ║ SHORTCUT ║
        // ╠══════════╩══════════╩══════════╩══════════╣
        // ║              PLAY/PAUSE (encoder btn)      ║
        // ╚════════════════════════════════════════════╝
        //   Encoder rotation: Volume Up / Volume Down
        default_layer {
            display-name = "Media";
            bindings = <
                &kp C_PREV         &kp C_PP           &kp C_NEXT         &kp C_MUTE
                &rgb_ug RGB_TOG    &rgb_ug RGB_EFF    &rgb_ug RGB_BRI    &rgb_ug RGB_HUI
                &bt BT_SEL 0       &bt BT_SEL 1       &bt BT_SEL 2       &bt BT_CLR
                &bt BT_PRV         &bt BT_NXT         &out OUT_TOG       &mo SHORTCUTS
                &kp C_PP
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // ╔══════════╦══════════╦══════════╦══════════╗
        // ║  UNDO    ║  REDO    ║  COPY    ║  PASTE   ║  Clipboard / history
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║  CUT     ║ SELECT   ║  FIND    ║  SAVE    ║  Common editing
        // ║          ║   ALL    ║          ║          ║
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║SCREENSHOT║SCREENSHOT║ NEW TAB  ║CLOSE TAB ║  Screen + browser
        // ║  FULL    ║  REGION  ║          ║          ║
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║ APP      ║ MISSION  ║ STUDIO   ║  [HOLD]  ║  System + firmware
        // ║ SWITCH   ║ CONTROL  ║ UNLOCK   ║          ║
        // ╠══════════╩══════════╩══════════╩══════════╣
        // ║                 MUTE (encoder btn)         ║
        // ╚════════════════════════════════════════════╝
        //   Encoder rotation: Page Up / Page Down
        //   Note: shortcuts use macOS keys (LG = Cmd). For Windows swap LG→LC.
        shortcuts_layer {
            display-name = "Shortcuts";
            bindings = <
                &kp LG(Z)          &kp LG(LS(Z))      &kp LG(C)          &kp LG(V)
                &kp LG(X)          &kp LG(A)          &kp LG(F)          &kp LG(S)
                &kp LG(LS(N3))     &kp LG(LS(N4))     &kp LG(T)          &kp LG(W)
                &kp LG(TAB)        &kp LC(UP)         &studio_unlock     &trans
                &kp C_MUTE
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
