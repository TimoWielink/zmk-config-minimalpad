#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/minimalpad/dial.h>

#define DEFAULT_LAYER 0
#define CONNECTIONS 1

/ {
    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder0>;
        triggers-per-rotation = <10>;
    };

    behaviors {
        // The dial. Each layer's turn can be changed in MinimalPad Studio for Mac, which
        // keeps the choice on the pad: a key, a scroll or a lighting step, with modifiers.
        // Until then it does what these say. A layer with no dial of its own, such as an
        // app profile, gets the dial of the layer below.
        dial_volume: dial_volume {
            compatible = "minimalpad,behavior-host-dial";
            #sensor-binding-cells = <0>;
            clockwise = <C_VOL_UP>;
            counter-clockwise = <C_VOL_DN>;
        };

        dial_lights: dial_lights {
            compatible = "minimalpad,behavior-host-dial";
            #sensor-binding-cells = <0>;
            clockwise = <DIAL_LIGHTS_BRIGHTER>;
            counter-clockwise = <DIAL_LIGHTS_DIMMER>;
        };

        // Mac action key: does nothing on the pad, tells MinimalPad Studio for Mac
        // which action id went down or up. No key uses it here; Studio assigns it.
        mac_action: mac_action {
            compatible = "minimalpad,behavior-mac-action";
            #binding-cells = <1>;
            display-name = "Mac Action";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ╔══════════╦══════════╦══════════╦══════════╗
        // ║SPOTLIGHT ║ MISSION  ║  EMOJI   ║   LOCK   ║  Find, see every window, emoji, lock
        // ║          ║ CONTROL  ║          ║  SCREEN  ║
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║   COPY   ║  PASTE   ║   UNDO   ║   REDO   ║  Editing
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║SCREENSHOT║ CAPTURE  ║  SCREEN  ║  SCREEN  ║  Screenshots + display brightness
        // ║   AREA   ║  TOOLS   ║  BRI −   ║  BRI +   ║
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║   PREV   ║  PLAY/   ║   NEXT   ║ [HOLD]→  ║  Media + layer hold
        // ║  TRACK   ║  PAUSE   ║  TRACK   ║ CONNECT. ║
        // ╠══════════╩══════════╩══════════╩══════════╣
        // ║           MUTE  (encoder button)          ║
        // ╚═══════════════════════════════════════════╝
        //   Encoder rotation: Volume Up / Volume Down, unless changed in Studio
        //   The shortcuts are macOS ones: Cmd Space, Ctrl Up, Ctrl Cmd Space,
        //   Ctrl Cmd Q, Cmd C / V / Z, Cmd Shift Z, Cmd Shift 4 and Cmd Shift 5.
        //   Hold the BOTTOM-RIGHT key to reach the Connections & LEDs layer.
        default_layer {
            display-name = "Default";
            bindings = <
                &kp LG(SPACE)      &kp LC(UP)         &kp LC(LG(SPACE))  &kp LC(LG(Q))
                &kp LG(C)          &kp LG(V)          &kp LG(Z)          &kp LG(LS(Z))
                &kp LG(LS(N4))     &kp LG(LS(N5))     &kp C_BRI_DN       &kp C_BRI_UP
                &kp C_PREV         &kp C_PP           &kp C_NEXT         &mo CONNECTIONS
                &kp C_MUTE
            >;
            sensor-bindings = <&dial_volume>;
        };

        // ╔══════════╦══════════╦══════════╦══════════╗
        // ║BLUETOOTH ║BLUETOOTH ║BLUETOOTH ║BLUETOOTH ║  Paired devices 1-4
        // ║    1     ║    2     ║    3     ║    4     ║
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║BLUETOOTH ║   USE    ║   USE    ║  CLEAR   ║  Device 5, choose the connection,
        // ║    5     ║   USB    ║BLUETOOTH ║ PAIRING  ║  forget this device's pairing
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║  LIGHTS  ║   NEXT   ║  COLOUR  ║  COLOUR  ║  Lights
        // ║  ON/OFF  ║  EFFECT  ║    −     ║    +     ║
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║  LIGHTS  ║  LIGHTS  ║          ║  (HELD)  ║  Light brightness
        // ║  DIMMER  ║ BRIGHTER ║    —     ║          ║
        // ╠══════════╩══════════╩══════════╩══════════╣
        // ║      LIGHTS ON/OFF  (encoder button)      ║
        // ╚═══════════════════════════════════════════╝
        //   Active while the bottom-right key is held (from the Default layer).
        //   Encoder rotation here: light brightness up / down, unless changed in Studio.
        //   USE USB and USE BLUETOOTH pick where keys go. The pad answers MinimalPad
        //   Studio only on that connection, so choose USB to edit over a cable.
        //   CLEAR PAIRING sits at the end of its row, away from the device keys, so it is
        //   not pressed by mistake.
        connections_layer {
            display-name = "Connections & LEDs";
            bindings = <
                &bt BT_SEL 0       &bt BT_SEL 1       &bt BT_SEL 2       &bt BT_SEL 3
                &bt BT_SEL 4       &out OUT_USB       &out OUT_BLE       &bt BT_CLR
                &rgb_ug RGB_TOG    &rgb_ug RGB_EFF    &rgb_ug RGB_HUD    &rgb_ug RGB_HUI
                &rgb_ug RGB_BRD    &rgb_ug RGB_BRI    &none              &trans
                &rgb_ug RGB_TOG
            >;
            sensor-bindings = <&dial_lights>;
        };

        // Reserved slots, where MinimalPad Studio for Mac adds profile layers with ZMK
        // Studio's add_layer: 14 of them, for 16 layers with Default and Connections &
        // LEDs. Only builds with ZMK Studio compile them in; without it the keymap is the
        // two layers above.
        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };

        extra_4 {
            status = "reserved";
        };

        extra_5 {
            status = "reserved";
        };

        extra_6 {
            status = "reserved";
        };

        extra_7 {
            status = "reserved";
        };

        extra_8 {
            status = "reserved";
        };

        extra_9 {
            status = "reserved";
        };

        extra_10 {
            status = "reserved";
        };

        extra_11 {
            status = "reserved";
        };

        extra_12 {
            status = "reserved";
        };

        extra_13 {
            status = "reserved";
        };

        extra_14 {
            status = "reserved";
        };
    };
};
