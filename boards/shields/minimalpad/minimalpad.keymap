#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

#define MEDIA 0
#define BTLED 1

/ {
    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder0>;
        triggers-per-rotation = <10>;
    };

    behaviors {
        // Encoder rotation → RGB brightness (used on the BT+LED layer).
        // inc_dec_kp only wraps key presses, so RGB needs a dedicated
        // sensor-rotate behavior. CW = brighter, CCW = dimmer.
        rgb_encoder: rgb_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ╔══════════╦══════════╦══════════╦══════════╗
        // ║  PREV    ║  PLAY/   ║  NEXT    ║  MUTE    ║  Transport + mute
        // ║  TRACK   ║  PAUSE   ║  TRACK   ║          ║
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║  VOL −   ║  VOL +   ║  STOP    ║  EJECT   ║  Volume + stop/eject
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║ REWIND   ║  FAST    ║ SCREEN   ║ SCREEN   ║  Scrub + screen brightness
        // ║          ║  FWD     ║ BRI −    ║ BRI +    ║
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║  VOL −   ║  VOL +   ║  PLAY/   ║ [HOLD]→  ║  Quick controls + layer hold
        // ║          ║          ║  PAUSE   ║ BT + LED ║
        // ╠══════════╩══════════╩══════════╩══════════╣
        // ║        PLAY / PAUSE  (encoder button)      ║
        // ╚════════════════════════════════════════════╝
        //   Encoder rotation: Volume Up / Volume Down
        //   Hold the BOTTOM-RIGHT key to reach the BT + LED layer.
        media_layer {
            display-name = "Media";
            bindings = <
                &kp C_PREV      &kp C_PP        &kp C_NEXT      &kp C_MUTE
                &kp C_VOL_DN    &kp C_VOL_UP    &kp C_STOP      &kp C_EJECT
                &kp C_RW        &kp C_FF        &kp C_BRI_DN    &kp C_BRI_UP
                &kp C_VOL_DN    &kp C_VOL_UP    &kp C_PP        &mo BTLED
                &kp C_PP
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // ╔══════════╦══════════╦══════════╦══════════╗
        // ║ BT PROF  ║ BT PROF  ║ BT PROF  ║ BT PROF  ║  Select paired device
        // ║    1     ║    2     ║    3     ║    4     ║
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║ BT PROF  ║ BT NEXT  ║ BT PREV  ║ USB/BLE  ║  Profile 5 + cycle + output
        // ║    5     ║          ║          ║  TOGGLE  ║
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║ LED      ║ LED      ║ LED      ║ LED      ║  Brightness + animation speed
        // ║ BRI +    ║ BRI −    ║ SPEED +  ║ SPEED −  ║
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║ LED      ║ LED      ║ LED      ║          ║  Hue + effect + on/off
        // ║ HUE +    ║ EFFECT   ║ ON/OFF   ║    —     ║
        // ╠══════════╩══════════╩══════════╩══════════╣
        // ║        (encoder btn — release to exit)     ║
        // ╚════════════════════════════════════════════╝
        //   Active while the encoder button is held (from the Media layer).
        //   Encoder rotation here: LED Brightness Up / Down.
        btled_layer {
            display-name = "BT + LED";
            bindings = <
                &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3
                &bt BT_SEL 4    &bt BT_NXT      &bt BT_PRV      &out OUT_TOG
                &rgb_ug RGB_BRI &rgb_ug RGB_BRD &rgb_ug RGB_SPI &rgb_ug RGB_SPD
                &rgb_ug RGB_HUI &rgb_ug RGB_EFF &rgb_ug RGB_TOG &trans
                &trans
            >;
            sensor-bindings = <&rgb_encoder>;
        };

        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
