#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT_LAYER 0
#define BTLED 1

/ {
    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder0>;
        triggers-per-rotation = <10>;
    };

    behaviors {
        // Encoder rotation → RGB brightness (used on the BT+LED layer).
        // inc_dec_kp only wraps key presses, so RGB needs a dedicated
        // sensor-rotate behavior. CW = brighter, CCW = dimmer.
        rgb_encoder: rgb_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
        };

        // The dial on Default, and so in every profile, which defines no dial of its own.
        // MinimalPad Studio can give each profile its own dial action: a key or a scroll,
        // with modifiers. Without Studio, and when the pad falls back to Default, it
        // changes the volume. BT + LED keeps its own dial.
        host_dial: host_dial {
            compatible = "minimalpad,behavior-host-dial";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
        };

        // Mac action key: does nothing on the pad, tells MinimalPad Studio for Mac
        // which action id went down or up. No key uses it here; Studio assigns it.
        mac_action: mac_action {
            compatible = "minimalpad,behavior-mac-action";
            #binding-cells = <1>;
            display-name = "Mac Action";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ╔══════════╦══════════╦══════════╦══════════╗
        // ║SPOTLIGHT ║ MISSION  ║  EMOJI   ║   LOCK   ║  Find, see every window, emoji, lock
        // ║          ║ CONTROL  ║          ║  SCREEN  ║
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║   COPY   ║  PASTE   ║   UNDO   ║   REDO   ║  Editing
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║SCREENSHOT║ CAPTURE  ║  SCREEN  ║  SCREEN  ║  Screenshots + display brightness
        // ║   AREA   ║  TOOLS   ║  BRI −   ║  BRI +   ║
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║   PREV   ║  PLAY/   ║   NEXT   ║ [HOLD]→  ║  Media + layer hold
        // ║  TRACK   ║  PAUSE   ║  TRACK   ║ BT + LED ║
        // ╠══════════╩══════════╩══════════╩══════════╣
        // ║           MUTE  (encoder button)          ║
        // ╚═══════════════════════════════════════════╝
        //   Encoder rotation: Volume Up / Volume Down, or the active profile's dial action
        //   The shortcuts are macOS ones: Cmd Space, Ctrl Up, Ctrl Cmd Space,
        //   Ctrl Cmd Q, Cmd C / V / Z, Cmd Shift Z, Cmd Shift 4 and Cmd Shift 5.
        //   Hold the BOTTOM-RIGHT key to reach the BT + LED layer.
        default_layer {
            display-name = "Default";
            bindings = <
                &kp LG(SPACE)      &kp LC(UP)         &kp LC(LG(SPACE))  &kp LC(LG(Q))
                &kp LG(C)          &kp LG(V)          &kp LG(Z)          &kp LG(LS(Z))
                &kp LG(LS(N4))     &kp LG(LS(N5))     &kp C_BRI_DN       &kp C_BRI_UP
                &kp C_PREV         &kp C_PP           &kp C_NEXT         &mo BTLED
                &kp C_MUTE
            >;
            sensor-bindings = <&host_dial>;
        };

        // ╔══════════╦══════════╦══════════╦══════════╗
        // ║BLUETOOTH ║BLUETOOTH ║BLUETOOTH ║BLUETOOTH ║  Paired devices 1-4
        // ║    1     ║    2     ║    3     ║    4     ║
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║BLUETOOTH ║  CLEAR   ║   USE    ║   USE    ║  Device 5, forget this device's
        // ║    5     ║ PAIRING  ║   USB    ║BLUETOOTH ║  pairing, choose the connection
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║  LIGHTS  ║   NEXT   ║  COLOUR  ║  COLOUR  ║  Lights
        // ║  ON/OFF  ║  EFFECT  ║    −     ║    +     ║
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║  LIGHTS  ║  LIGHTS  ║          ║  (HELD)  ║  Light brightness
        // ║  DIMMER  ║ BRIGHTER ║    —     ║          ║
        // ╠══════════╩══════════╩══════════╩══════════╣
        // ║      LIGHTS ON/OFF  (encoder button)      ║
        // ╚═══════════════════════════════════════════╝
        //   Active while the bottom-right key is held (from the Default layer).
        //   Encoder rotation here: light brightness up / down.
        //   USE USB and USE BLUETOOTH pick where keys go. The pad answers MinimalPad
        //   Studio only on that connection, so choose USB to edit over a cable.
        btled_layer {
            display-name = "BT + LED";
            bindings = <
                &bt BT_SEL 0       &bt BT_SEL 1       &bt BT_SEL 2       &bt BT_SEL 3
                &bt BT_SEL 4       &bt BT_CLR         &out OUT_USB       &out OUT_BLE
                &rgb_ug RGB_TOG    &rgb_ug RGB_EFF    &rgb_ug RGB_HUD    &rgb_ug RGB_HUI
                &rgb_ug RGB_BRD    &rgb_ug RGB_BRI    &none              &trans
                &rgb_ug RGB_TOG
            >;
            sensor-bindings = <&rgb_encoder>;
        };

        // Reserved slots, where MinimalPad Studio for Mac adds profile layers with ZMK
        // Studio's add_layer: 14 of them, for 16 layers with Default and BT + LED. Only
        // builds with ZMK Studio compile them in; without it the keymap is the two layers
        // above.
        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };

        extra_4 {
            status = "reserved";
        };

        extra_5 {
            status = "reserved";
        };

        extra_6 {
            status = "reserved";
        };

        extra_7 {
            status = "reserved";
        };

        extra_8 {
            status = "reserved";
        };

        extra_9 {
            status = "reserved";
        };

        extra_10 {
            status = "reserved";
        };

        extra_11 {
            status = "reserved";
        };

        extra_12 {
            status = "reserved";
        };

        extra_13 {
            status = "reserved";
        };

        extra_14 {
            status = "reserved";
        };
    };
};
