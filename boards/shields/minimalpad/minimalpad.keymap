#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT   0
#define SHORTCUTS 1
#define LED       2

/ {
    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder0>;
        triggers-per-rotation = <10>;
    };

    behaviors {
        // Encoder rotation → RGB brightness (used on the LED layer).
        // inc_dec_kp only wraps key presses, so RGB needs a dedicated
        // sensor-rotate behavior. CW = brighter, CCW = dimmer.
        rgb_encoder: rgb_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ╔══════════╦══════════╦══════════╦══════════╗
        // ║  PREV    ║  PLAY/   ║  NEXT    ║  MUTE    ║  Media transport + mute
        // ║  TRACK   ║  PAUSE   ║  TRACK   ║          ║
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║ BT PROF  ║ BT PROF  ║ BT CLEAR ║ RGB      ║  BT profiles 4/5 + reset + lights
        // ║    4     ║    5     ║   ALL    ║ TOGGLE   ║
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║ BT PROF  ║ BT PROF  ║ BT PROF  ║ BT CLEAR ║  Bluetooth profiles
        // ║    1     ║    2     ║    3     ║ this dev ║
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║ BT PREV  ║ BT NEXT  ║ USB/BLE  ║ [HOLD]→  ║  BT nav + output + layer
        // ║ PROFILE  ║ PROFILE  ║  TOGGLE  ║ SHORTCUT ║
        // ╠══════════╩══════════╩══════════╩══════════╣
        // ║   TAP: PLAY/PAUSE   HOLD: LED layer        ║  encoder button = layer-tap
        // ╚════════════════════════════════════════════╝
        //   Encoder rotation: Volume Up / Volume Down
        default_layer {
            display-name = "Media";
            bindings = <
                &kp C_PREV         &kp C_PP           &kp C_NEXT         &kp C_MUTE
                &bt BT_SEL 3       &bt BT_SEL 4       &bt BT_CLR_ALL     &rgb_ug RGB_TOG
                &bt BT_SEL 0       &bt BT_SEL 1       &bt BT_SEL 2       &bt BT_CLR
                &bt BT_PRV         &bt BT_NXT         &out OUT_TOG       &mo SHORTCUTS
                &lt LED C_PP
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // ╔══════════╦══════════╦══════════╦══════════╗
        // ║  UNDO    ║  REDO    ║  COPY    ║  PASTE   ║  Clipboard / history
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║  CUT     ║ SELECT   ║  FIND    ║  SAVE    ║  Common editing
        // ║          ║   ALL    ║          ║          ║
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║SCREENSHOT║SCREENSHOT║ NEW TAB  ║CLOSE TAB ║  Screen + browser
        // ║  FULL    ║  REGION  ║          ║          ║
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║ APP      ║ MISSION  ║ STUDIO   ║  [HOLD]  ║  System + firmware
        // ║ SWITCH   ║ CONTROL  ║ UNLOCK   ║          ║
        // ╠══════════╩══════════╩══════════╩══════════╣
        // ║                 MUTE (encoder btn)         ║
        // ╚════════════════════════════════════════════╝
        //   Encoder rotation: Page Up / Page Down
        //   Note: shortcuts use macOS keys (LG = Cmd). For Windows swap LG→LC.
        shortcuts_layer {
            display-name = "Shortcuts";
            bindings = <
                &kp LG(Z)          &kp LG(LS(Z))      &kp LG(C)          &kp LG(V)
                &kp LG(X)          &kp LG(A)          &kp LG(F)          &kp LG(S)
                &kp LG(LS(N3))     &kp LG(LS(N4))     &kp LG(T)          &kp LG(W)
                &kp LG(TAB)        &kp LC(UP)         &studio_unlock     &trans
                &kp C_MUTE
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        // ╔══════════╦══════════╦══════════╦══════════╗
        // ║  RED     ║  GREEN   ║  BLUE    ║  WHITE   ║  Color presets (edit in Studio)
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║  HUE +   ║  HUE −   ║  SAT +   ║  SAT −   ║  Color tuning
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║  BRI +   ║  BRI −   ║ SPEED +  ║ SPEED −  ║  Brightness + animation speed
        // ╠══════════╬══════════╬══════════╬══════════╣
        // ║ EFFECT → ║ EFFECT ← ║  ON/OFF  ║    —     ║  Effect cycle + toggle
        // ╠══════════╩══════════╩══════════╩══════════╣
        // ║        (encoder btn — release to exit)     ║
        // ╚════════════════════════════════════════════╝
        //   Active while the encoder button is held (from the Media layer).
        //   Encoder rotation here: Brightness Up / Brightness Down.
        led_layer {
            display-name = "LED";
            bindings = <
                &rgb_ug RGB_COLOR_HSB(0,100,80)    &rgb_ug RGB_COLOR_HSB(120,100,80)   &rgb_ug RGB_COLOR_HSB(240,100,80)   &rgb_ug RGB_COLOR_HSB(0,0,90)
                &rgb_ug RGB_HUI    &rgb_ug RGB_HUD    &rgb_ug RGB_SAI    &rgb_ug RGB_SAD
                &rgb_ug RGB_BRI    &rgb_ug RGB_BRD    &rgb_ug RGB_SPI    &rgb_ug RGB_SPD
                &rgb_ug RGB_EFF    &rgb_ug RGB_EFR    &rgb_ug RGB_TOG    &none
                &trans
            >;
            sensor-bindings = <&rgb_encoder>;
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
